# Central Coordinator Web App URL
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec

# GitHub Personal Access Token (for silent git fetch / pull / auto-update without credential prompts)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Telegram Bot Configuration for Udyam Scraper
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_or_channel_id_here
TELEGRAM_INTERVAL=1800
